# Force Unity text assets to use LF line endings and enable smart merge
*.cs        text eol=lf diff=csharp
*.shader    text eol=lf
*.cginc     text eol=lf
*.hlsl      text eol=lf
*.compute   text eol=lf
*.asmdef    text eol=lf
*.json      text eol=lf
*.md        text eol=lf

# Unity asset files — use UnityYAMLMerge for conflict resolution
*.unity     merge=unityyamlmerge eol=lf
*.prefab    merge=unityyamlmerge eol=lf
*.asset     merge=unityyamlmerge eol=lf
*.meta      merge=unityyamlmerge eol=lf
*.controller merge=unityyamlmerge eol=lf
*.anim      merge=unityyamlmerge eol=lf

# Treat binary files correctly — no line ending conversion, no diff
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.psd       binary
*.tga       binary
*.pdf       binary
*.mp3       binary
*.wav       binary
*.ogg       binary
*.fbx       binary
*.obj       binary
*.blend     binary
*.unitypackage binary
